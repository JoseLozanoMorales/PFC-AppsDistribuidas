# Base de datos PostgreSQL usada por los servicios en el perfil normal
TT_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/TiendaTechV19
TT_DATASOURCE_USERNAME=postgres
TT_DATASOURCE_PASSWORD=cambiar_en_local

# Autenticacion y correo; use valores locales, nunca secretos reales del equipo
AUTH_JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
COOKIE_SECURE=false
TT_MAIL_USERNAME=
TT_MAIL_PASSWORD=

# CockroachDB (perfil e3-crdb)
CRDB_DATASOURCE_URL=jdbc:postgresql://crdb-1:26257/tiendatech?sslmode=disable
CRDB_DATASOURCE_USERNAME=root
CRDB_DATASOURCE_PASSWORD=
CRDB_RETRY_MAX_ATTEMPTS=3
CRDB_RETRY_DELAY_MS=100
CRDB_POOL_MAX_SIZE=10
CRDB_POOL_MIN_IDLE=2
