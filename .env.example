# CockroachDB distribuido (único motor de persistencia)
CRDB_DATASOURCE_URL=jdbc:postgresql://crdb-1:26257,crdb-2:26257,crdb-3:26257/tiendatech?sslmode=disable&targetServerType=any&loadBalanceHosts=true
CRDB_DATASOURCE_USERNAME=root
CRDB_DATASOURCE_PASSWORD=
CRDB_RETRY_MAX_ATTEMPTS=3
CRDB_RETRY_DELAY_MS=100
CRDB_POOL_MAX_SIZE=10
CRDB_POOL_MIN_IDLE=2

# Autenticacion y correo; use valores locales, nunca secretos reales del equipo
AUTH_JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
COOKIE_SECURE=false
TT_MAIL_USERNAME=
TT_MAIL_PASSWORD=
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
