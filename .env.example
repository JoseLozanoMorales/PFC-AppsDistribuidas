# CockroachDB distribuido (único motor de persistencia)
CRDB_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:26257,host.docker.internal:26258,host.docker.internal:26259/tiendatech?sslmode=verify-ca&sslrootcert=/app/crdb-certs/ca.crt&sslcert=/app/crdb-certs/client.jhinson.crt&sslkey=/app/crdb-certs/client.jhinson.key.pk8&targetServerType=any&loadBalanceHosts=true
CRDB_DATASOURCE_USERNAME=jhinson
CRDB_DATASOURCE_PASSWORD=
CRDB_RETRY_MAX_ATTEMPTS=3
CRDB_RETRY_DELAY_MS=100
CRDB_POOL_MAX_SIZE=10
CRDB_POOL_MIN_IDLE=2

# Autenticacion y correo; use valores locales, nunca secretos reales del equipo
AUTH_JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
COOKIE_SECURE=false
TT_MAIL_USERNAME=
TT_MAIL_PASSWORD=
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000

# AWS Bedrock: credenciales del microservicio armado-ia (analisis de cuello de botella).
# Cada integrante usa su propia clave IAM con permiso unicamente sobre Nova Lite.
# Si faltan estas variables el servicio sigue funcionando con el fallback deterministico.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Despliegue de imágenes publicadas en Docker Hub
DOCKERHUB_REPOSITORY=josemoralito/tiendatech
IMAGE_TAG=latest
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=8180
CRDB_CERTS_DIR=./crdb-certs
